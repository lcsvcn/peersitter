{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PeerSitter",
  "version": "0.1.0",
  "identifier": "dev.peersitter.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../homekit install --omit=dev --no-audit --no-fund && npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "title": "PeerSitter",
        "width": 1000,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 420,
        "minHeight": 560,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "underWindowBackground"
          ],
          "state": "followsWindowActiveState"
        },
        "trafficLightPosition": {
          "x": 24,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "../../homekit/src": "homekit/src",
      "../../homekit/node_modules": "homekit/node_modules",
      "../../homekit/package.json": "homekit/package.json"
    }
  }
}
